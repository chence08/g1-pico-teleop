# Copy to config/local.env; keep that machine-specific file out of Git.
# These are defaults for a standard G1 Orin account; edit for your installation.
G1_HOST=g1
G1_REMOTE_ROOT=/home/unitree/g1_dataset
G1_REMOTE_PYTHON=/home/unitree/miniconda3/envs/unitree_deploy/bin/python
G1_DDS_INTERFACE=enP8p1s0
INSPIRE_LEFT_PORT=/dev/g1_inspire_left
INSPIRE_RIGHT_PORT=/dev/g1_inspire_right
# Optional overrides. Otherwise use pinned third_party checkout / Conda environments.
# XR_TELEOPERATE_REPO=/absolute/path/to/xr_teleoperate
# IK_PYTHON=/absolute/path/to/envs/g1-ik/bin/python
# NATIVE_PYTHON=/absolute/path/to/envs/g1-pico/bin/python
# PICO_SERVICE_SCRIPT=/absolute/path/to/runService.sh
# PICO_SDK_LIBRARY=/absolute/path/to/libPXREARobotSDK.so
# PICO_APK=/absolute/path/to/official-XRoboToolkit.apk
# PICO_SERIAL=adb-device-serial
